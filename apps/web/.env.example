# Copy to .env.local. NEXT_PUBLIC_* values are inlined into the static build and are
# public: never put secrets here.

# Canonical site origin, used for canonical/hreflang URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rails API origin (without /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Include the /[locale]/design-system page in a production build (never in production).
# It is always available under `next dev`.
# NEXT_PUBLIC_ENABLE_DESIGN_SYSTEM=true
