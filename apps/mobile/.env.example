# Copy to .env.local. EXPO_PUBLIC_* values are embedded in the app bundle:
# never put secrets here.

# Rails API base URL. On a physical device use your machine's LAN IP
# (e.g. http://192.168.1.20:3001); the Android emulator uses http://10.0.2.2:3001.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Google OAuth client IDs (public). Email/password works without these.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=123.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
