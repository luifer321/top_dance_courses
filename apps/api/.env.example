# Copy to apps/api/.env for local development. Never commit real values.

# --- Local PostgreSQL (Postgres.app / Homebrew / Docker on localhost:5432)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=

# --- CORS: exact origins allowed to call /api/* (comma-separated)
# Defaults outside production: http://localhost:3000 (web), http://localhost:8081 (Expo web)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Development admin created by `bin/rails db:seed`
# DEV_ADMIN_EMAIL=admin@topdance.local
# DEV_ADMIN_PASSWORD=topdance-dev-password

# --- Production only (set in Railway, shown here for reference)
# RAILS_MASTER_KEY=
# DATABASE_URL=postgres://...
# CACHE_DATABASE_URL=postgres://.../top_dance_production_cache
# QUEUE_DATABASE_URL=postgres://.../top_dance_production_queue
# CABLE_DATABASE_URL=postgres://.../top_dance_production_cable
# APP_HOST=api.topdance.academy
# APP_HOSTS=api.topdance.academy
# CORS_ORIGINS=https://topdance.academy,https://www.topdance.academy
# MAILER_FROM=Top Dance Academy <no-reply@topdance.academy>
# API_DOCS_ENABLED=false

# --- Future integrations (not used yet)
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_API_KEY=
# BUNNY_STREAM_TOKEN_AUTH_KEY=
# RESEND_API_KEY=
# SENTRY_DSN=
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# REVENUECAT_WEBHOOK_AUTH=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
